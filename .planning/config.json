{
  "mode": "yolo",
  "granularity": "standard",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "balanced",
  "model_overrides": {
    "gsd-phase-researcher": "haiku",
    "gsd-project-researcher": "haiku"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
